<project name="spectrumapplet" default="distAll" basedir=".">
        <property name="build" value="build" />
        <property name="src" value="src" />
        <property name="srcTemp" value="srcTemp" />
        <property name="src_test" value="test" />
        <property name="dist" value="dist" />
        <property name="lib" value="lib" />
        <property name="bin" value="bin" />
        <property name="doc" value="doc" />
        <property name="demo" value="demo" />
		<property file="build.properties"/>
	
        <path id="project.class.path">
                <pathelement location="${build}" />
                <fileset dir="${lib}">
                        <include name="*.jar" />
                </fileset>
		<pathelement location="${jre_plugin_jar}"/>
        </path>

        <target name="initCompile">
                <delete dir="${build}" />
                <mkdir dir="${build}" />
                <delete dir="${srcTemp}" />
                <mkdir dir="${srcTemp}" />
                <mkdir dir="${dist}" />
                <copy toDir="${srcTemp}">
                   <fileset dir="${src}"/>
                </copy>
                <copy toDir="${build}/conf">
                   <fileset dir="${src}/java/conf"/>
                </copy>
        </target>

        <target name="compileMarvin">
                <antcall target="initCompile"/>
                <delete file="${srcTemp}/org/openscience/nmrshiftdb/spectrumapplet/SpectrumView.java"/>
                <delete file="${srcTemp}/org/openscience/nmrshiftdb/spectrumapplet/util/JChemPaintWrapper.java"/>
                <javac srcdir="${srcTemp}" destdir="${build}" target="1.2" optimize="on" debug="off" deprecation="on" source="1.2">
                        <classpath refid="project.class.path" />
                </javac>
        </target>

        <target name="compileJChemPaint">
                <antcall target="initCompile"/>
                <delete file="${srcTemp}/MarvinWrapper.java"/>
                <delete file="${srcTemp}/SpectrumView.java"/>
                <javac srcdir="${srcTemp}" destdir="${build}" target="1.2" optimize="on" debug="off" deprecation="on" source="1.2">
                        <classpath refid="project.class.path" />
                </javac>
        </target>
        
        <target name="compileTest">
                <javac srcdir="${src_test}" destdir="${build}" target="1.2" optimize="on" debug="off" deprecation="on">
                        <classpath refid="project.class.path" />
                </javac>
        </target>

        <target name="clean">
                <delete dir="${dist}" />
                <delete dir="${doc}" />
        </target>

        <target name="distMarvin" depends="compileMarvin">
                <delete dir="${build}/tests" />
                <mkdir dir="${dist}/forMarvin" />
                <jar jarfile="${dist}/forMarvin/${ant.project.name}.jar">
                        <fileset dir="${build}"/>
                </jar>
                <copy file="${dist}/forMarvin/${ant.project.name}.jar"
                      toDir="${demo}"/>
                <copy file="${lib}/xstream-1.1.jar"
                      toDir="${demo}"/>
                <copy file="${lib}/xpp3_min-1.1.3.4.K.jar"
                      toDir="${demo}"/>
        </target>
        
        <target name="distJChemPaint" depends="compileJChemPaint">
                <delete dir="${build}/tests" />
                <mkdir dir="${dist}/forJChemPaint" />
                <jar jarfile="${dist}/forJChemPaint/${ant.project.name}.jar">
                        <fileset dir="${build}"/>
                </jar>
        </target>

        <target name="distAll" depends="clean,distMarvin,distJChemPaint">
        </target>

        <target name="test" depends="clean,distMarvin">
                <exec executable="appletviewer">
                        <arg line="${demo}/antTest.html"/>
                </exec>
        </target>


        <target name="javadoc">
                <mkdir dir="${doc}/api" />
                <javadoc packagenames="org.*"
                         sourcepath="${src}/java" 
                         destdir="${doc}/api" access="private">
                        <classpath refid="project.class.path" />
                </javadoc>
        </target>

</project>




