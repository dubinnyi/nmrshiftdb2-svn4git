<rdf:RDF
  xmlns:rdf = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:ocs = "http://alchemy.openjava.org/ocs/ocs-syntax#"
  xmlns:dc  = "http://purl.org/dc/elements/1.0/">
  <rdf:description about="http://jakarta.apache.org/jetspeed/channels/apache.ocs">
    <dc:title>Apache OCS feed</dc:title>
    <dc:creator>Raphaël Luta (mailto:raphael@apache.org)</dc:creator>
    <dc:description>This feed registers all the available news channels available from the ASF projects</dc:description>
        
      <rdf:description about="http://portals.apache.org/jetspeed-1/">
        <dc:title>Jetspeed</dc:title>
        <dc:creator>Jetspeed Project Team</dc:creator>
        <dc:description>Jetspeed is a multi-device portal system with simple syndication capabilities</dc:description>
        
          <rdf:description about="http://portals.apache.org/jetspeed-1/channels/jetspeed.rss">
            <dc:language>en</dc:language>
            <ocs:format>http://my.netscape.com/publish/formats/rss-0.91.dtd</ocs:format>
          </rdf:description>

      </rdf:description>
        
      <rdf:description about="http://jakarta.apache.org/turbine/">
        <dc:title>Turbine</dc:title>
        <dc:creator>Turbine Project Team</dc:creator>
        <dc:description>Turbine is a java web application development framework</dc:description>
        
          <rdf:description about="http://portals.apache.org/jetspeed-1/channels/turbine.rss">
            <dc:language>en</dc:language>
            <ocs:format>http://my.netscape.com/publish/formats/rss-0.91.dtd</ocs:format>
          </rdf:description>

      </rdf:description>
        
  </rdf:description>
</rdf:RDF>