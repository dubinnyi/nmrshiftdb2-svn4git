<html>
  <head>
    <base href="$clink.External">
    <link href="$clink.setURI($config.getString("site.stylesheet")).Absolute" type="text/css" rel="stylesheet">
    #set ($titlePrefix = $config.getString("portal.title"))
    <title>#if ($titlePrefix)$titlePrefix #else $data.profile.document.portlets.getMetaInfo().title#end</title>
## include site defined scripts for the html head (see the definition in templates/vm/GlobalMacros.vm)
    #headScripts()
  </head>
## include site defined body on load behavior, if any (see the definition in templates/vm/GlobalMacros.vm)
  <body bgcolor="#ffffff" #bodyOnLoad()>
    #if ($config.getBoolean("topnav.enable") == true)
    <table cellspacing="0" width="100%" border="0" cellpadding="0">
      <tr>
        <td>$jnavigation.setTemplate($config.getString("topnav.vm"))</td>
      </tr>
    </table>
    #end
    <table cellspacing="0" width="100%" cellpadding="0" border="0">
      <tr>
        #if ($config.getBoolean("leftnav.enable") == true)
        <td width="$config.getString("leftnav.width")" valign="top" bgcolor="#ffffff">   
          $jnavigation.setTemplate($config.getString("leftnav.vm"))
        </td>
        <td>&nbsp;</td>
        #end
        <td valign="top">
          $screen_placeholder 
        </td>
      </tr>
    </table>
    #if ($config.getBoolean("bottomnav.enable") == true)
    <table cellspacing="0" width="100%" cellpadding="0" border="0">
      <tr>
        <td valign="bottom" bgcolor="#ffffff">
          $jnavigation.setTemplate($config.getString("bottomnav.vm"))
        </td>
      </tr>
    </table>
   #end
  </body>
</html>
