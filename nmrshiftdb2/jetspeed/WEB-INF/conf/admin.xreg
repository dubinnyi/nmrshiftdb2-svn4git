<registry>
	<portlet-entry type="instance" name="Applications" hidden="false">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.ApplicationsPortlet</classname>
		<category>admin</category>
	</portlet-entry>
	<portlet-entry type="instance" name="PortletCustomizer" hidden="true">
		<security-ref parent="user-only"/>
		<meta-info>
			<title>Customize portlet</title>
		</meta-info>
		<classname>org.apache.jetspeed.portal.portlets.VelocityPortlet</classname>
		<parameter name="template" value="customizer-portlet" hidden="true"/>
		<parameter name="action" value="portlets.CustomizeAction" hidden="true"/>
		<parameter name="_security_ref" value="" type="style" hidden="false">
			<security-ref parent="user-only"/>
			<meta-info>
				<title>Security constraint for this resource. Be careful not to pick a constraint such as "Admin-only" which will lock you out of this resource.</title>
			</meta-info>
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="Security"/>
			</parameter-style>
		</parameter>
		<parameter name="_skin" value="" type="style" hidden="false">
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="Skin"/>
			</parameter-style>
		</parameter>
		<parameter name="_control" value="" type="style" hidden="false">
			<security-ref parent="user-only"/>
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="PortletControl"/>
				<style-option name="select-hidden" value="true"/>
				<style-option name="select-if-simple" value="true"/>
			</parameter-style>
		</parameter>
		<category>admin</category>
		<category>customize.portlet</category>
	</portlet-entry>
	<portlet-entry type="instance" name="PortletSetCustomizer" hidden="true">
		<security-ref parent="user-only"/>
		<classname>org.apache.jetspeed.portal.portlets.VelocityPortlet</classname>
		<parameter name="template" value="customizer-portletset" hidden="true"/>
		<parameter name="action" value="portlets.CustomizeSetAction" hidden="true"/>
		<parameter name="securityRef" value="" type="style" hidden="false">
			<security-ref parent="user-only"/>
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="Security"/>
				<style-option name="disabled-if-wml" value="true"/>
				<style-option name="javascript:onchange" value="document.securityRefs.submit()"/>
			</parameter-style>
		</parameter>
		<parameter name="portletSecurityRef" value="" type="style" hidden="false">
			<security-ref parent="user-only"/>
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="Security"/>
				<style-option name="disabled-if-wml" value="true"/>
				<style-option name="javascript:onchange" value="this.form.submit()"/>
				<style-option name="set-label" value="true"/>				
			</parameter-style>
		</parameter>
		<parameter name="skin" value="" type="style" hidden="false">
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="Skin"/>
				<style-option name="disabled-if-wml" value="true"/>
				<style-option name="javascript:onchange" value="document.skins.submit()"/>
			</parameter-style>
		</parameter>
		<parameter name="portletSkin" value="" type="style" hidden="false">
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="Skin"/>
				<style-option name="disabled-if-wml" value="true"/>
				<style-option name="javascript:onchange" value="this.form.submit()"/>
				<style-option name="set-label" value="true"/>				
			</parameter-style>
		</parameter>
		<parameter name="control" value="" type="style" hidden="false">
			<parameter-style name="RegistryEntryListBox">
				<style-option name="registry" value="PortletControl"/>
				<style-option name="disabled-if-wml" value="true"/>
				<style-option name="javascript:onchange" value="this.form.submit()"/>
				<style-option name="select-hidden" value="true"/>
				<style-option name="select-if-simple" value="true"/>
				<style-option name="set-label" value="true"/>
			</parameter-style>
		</parameter>
		<parameter name="addRef" value="" type="style" hidden="false">
			<security-ref parent="admin-only"/>
			<parameter-style name="VelocityParameterPresentationStyle" template="Button.vm">
				<style-option name="no-access" value="addRefDisabled"/>
			</parameter-style>
		</parameter>
		<parameter name="addRefDisabled" value="" type="style" hidden="false">
			<parameter-style name="VelocityParameterPresentationStyle" template="Button.vm">
				<style-option name="disabled" value="true"/>
				<style-option name="no-access" value="addRefDisabled"/>
			</parameter-style>
		</parameter>
		<meta-info>
			<title>Customize pane</title>
		</meta-info>
		<category>admin</category>
		<category>customize</category>
	</portlet-entry>
	<portlet-entry type="ref" name="ClientBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-client" hidden="true"/>
		<parameter name="registry" value="Client"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.RegistryBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Client browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="ref" name="PortletBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-portlet" hidden="true"/>
		<parameter name="registry" value="Portlet"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.PortletBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Portlet browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="ref" name="ControlBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-control" hidden="true"/>
		<parameter name="registry" value="PortletControl"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.RegistryBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Control browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="ref" name="ControllerBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-controller" hidden="true"/>
		<parameter name="registry" value="PortletController"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.RegistryBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Controller browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="ref" name="MediaBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-media" hidden="true"/>
		<parameter name="registry" value="MediaType"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.RegistryBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Media Types browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="ref" name="SkinBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-skin" hidden="true"/>
		<parameter name="registry" value="Skin"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.RegistryBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Skin browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="ref" name="SecurityBrowser" hidden="false" parent="GenericMVCPortlet">
		<security-ref parent="admin-only"/>
		<classname>org.apache.jetspeed.portal.portlets.GenericMVCPortlet</classname>
		<parameter name="template" value="browser-security" hidden="true"/>
		<parameter name="registry" value="Security"/>
		<parameter name="page-size" value="10"/>
		<parameter name="action" value="portlets.RegistryBrowseAction" hidden="true"/>
		<parameter name="viewtype" value="Velocity" hidden="true"/>
		<meta-info>
			<title>Security browser</title>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
		<category>browser</category>
	</portlet-entry>
	<portlet-entry type="instance" name="PortletInfoPortlet" hidden="true">
		<security-ref parent="user-only"/>
		<classname>org.apache.jetspeed.portal.portlets.PortletInfoPortlet</classname>
		<parameter name="thirdparty.portletrenderer.url" value="http://avantgo.com/mydevice/autoadd.html?max=300&amp;depth=5&amp;images=0&amp;links=0&amp;refresh=always&amp;hours=2&amp;dflags=127&amp;hour=0&amp;quarter=00&amp;s=00"/>
		<parameter name="thirdparty.portletrenderer.caption" value="Add to Avantgo"/>
		<meta-info>
			<title>Portlet Information</title>
			<description>Provides some information about a portlet</description>
		</meta-info>
		<media-type ref="html"/>
	</portlet-entry>
	<portlet-entry type="ref" parent="Velocity" name="Login" hidden="true">
		<parameter name="template" value="login" hidden="true"/>
		<parameter name="action" value="portlets.Login" hidden="true"/>
		<meta-info>
			<title>Login</title>
			<description>Login portlet</description>
		</meta-info>
		<media-type ref="html"/>
		<category>admin</category>
	</portlet-entry>
