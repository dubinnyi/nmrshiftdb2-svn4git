	<portlet-entry name="MediaForm" hidden="true" type="ref" parent="Velocity" application="false">
		<security-ref parent="admin-only"/>
		<meta-info>
			<title>Media</title>
			<description>Security Media Maintenance for Jetspeed</description>
		</meta-info>
		<classname>org.apache.jetspeed.portal.portlets.VelocityPortlet</classname>
		<parameter name="template" value="media-form" hidden="true" cachedOnName="true" cachedOnValue="true"/>
		<parameter name="action" value="portlets.MediaUpdateAction" hidden="true" cachedOnName="true" cachedOnValue="true"/>
