<!--
possible capabilities:

HTML_3_2
HTML_4_0
HTML_TABLE
HTML_NESTED_TABLE                   
HTML_FORM                   
HTML_FRAME                   
HTML_IMAGE                   
HTML_JAVA
HTML_JAVA_1_0
HTML_JAVA_1_1
HTML_JAVA_JRE
HTML_JAVASCRIPT
HTML_JAVASCRIPT_1_0
HTML_JAVASCRIPT_1_1
HTML_JAVASCRIPT_1_2                   
HTML_ACTIVE_X  
HTML_PLUGIN
HTML_CSS1
HTML_CSS2
HTML_CSSP
HTML_IFRAME
HTML_LAYER

HTML_DOM_IE
HTML_DOM_NS4
HTML_DOM_1
HTML_DOM_2

WML_1_0
WML_1_1
WML_TABLE

XML_XSLT
XML_XPATH
XML_XINCLUDE

HTTP_1_1                   
HTTP_COOKIE
-->

<registry>

    <client-entry name="ie5">
<!--Mozilla/4.0 (compatible; MSIE 5.5; Windows NT 5.0)-->
        <user-agent-pattern>.*MSIE 5.*</user-agent-pattern>
        <manufacturer>Microsoft</manufacturer>
        <model>None</model>
        <version>5.5</version>
        <mimetype-map>
            <mimetype>text/html</mimetype>
            <mimetype>text/xml</mimetype>
        </mimetype-map>
        <capability-map>
            <capability>HTML_3_2</capability>
            <capability>HTML_JAVA</capability>
            <capability>HTML_JAVASCRIPT</capability>
            <capability>HTML_TABLE</capability>
            <capability>HTML_NESTED_TABLE</capability>
            <capability>HTML_FORM</capability>
            <capability>HTML_FRAME</capability>
            <capability>HTML_IMAGE</capability>
            <capability>HTML_ACTIVE_X</capability>
            <capability>HTML_CSS1</capability>
            <capability>HTML_CSS2</capability>
            <capability>HTML_CSSP</capability>
            <capability>HTML_IFRAME</capability>
            <capability>HTML_DOM_IE</capability>
            <capability>HTTP_COOKIE</capability>
        </capability-map>
    </client-entry>

    <client-entry name="ns4">
<!--Mozilla/4.75 [en] (Windows NT 5.0; U)-->    
        <user-agent-pattern>.*Mozilla/4.*</user-agent-pattern>
        <manufacturer>Netscape</manufacturer>
        <model>None</model>
        <version>4.75</version>
        <mimetype-map>
            <mimetype>text/html</mimetype>
        </mimetype-map>
        <capability-map>
            <capability>HTML_3_2</capability>
            <capability>HTML_JAVA</capability>
            <capability>HTML_JAVASCRIPT</capability>
            <capability>HTML_TABLE</capability>
            <capability>HTML_FORM</capability>
            <capability>HTML_FRAME</capability>
            <capability>HTML_IMAGE</capability>
            <capability>HTML_CSS1</capability>
            <capability>HTML_LAYER</capability>
            <capability>HTML_PLUGIN</capability>
            <capability>HTML_DOM_NS4</capability>
            <capability>HTTP_COOKIE</capability>
        </capability-map>
    </client-entry>

    <client-entry name="mozilla">
<!--Mozilla/5.0 (Windows; U; Windows NT 5.0; en-US; rv:1.0rc1) Gecko/20020417-->    
        <user-agent-pattern>.*Mozilla/5.*</user-agent-pattern>
        <manufacturer>Mozilla</manufacturer>
        <model>Mozilla</model>
        <version>1.x</version>
        <mimetype-map>
            <mimetype>text/html</mimetype>
            <mimetype>text/xhtml</mimetype>
            <mimetype>text/xml</mimetype>
        </mimetype-map>
        <capability-map>
            <capability>HTML_3_2</capability>
            <capability>HTML_4_0</capability>
            <capability>HTML_JAVA</capability>
            <capability>HTML_JAVA_JRE</capability>
            <capability>HTML_JAVASCRIPT</capability>
            <capability>HTML_TABLE</capability>
            <capability>HTML_NESTED_TABLE</capability>
            <capability>HTML_FORM</capability>
            <capability>HTML_FRAME</capability>
            <capability>HTML_IFRAME</capability>
            <capability>HTML_IMAGE</capability>
            <capability>HTML_CSS1</capability>
            <capability>HTML_CSS2</capability>
            <capability>HTML_CSSP</capability>
            <capability>HTML_DOM_1</capability>
            <capability>HTML_PLUGIN</capability>
            <capability>HTTP_COOKIE</capability>
        </capability-map>
    </client-entry>

    <client-entry name="lynx">
<!--Lynx text browser-->    
        <user-agent-pattern>Lynx.*</user-agent-pattern>
        <manufacturer>GNU</manufacturer>
        <model>None</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/html</mimetype>
        </mimetype-map>
        <capability-map>
            <capability>HTML_TABLE</capability>
            <capability>HTML_NESTED_TABLE</capability>
            <capability>HTML_FORM</capability>
            <capability>HTML_FRAME</capability>
            <capability>HTTP_COOKIE</capability>
        </capability-map>
    </client-entry>

    <client-entry name="nokia_generic">
<!--  Any Nokia WML stack -->    
        <user-agent-pattern>Nokia.*</user-agent-pattern>
        <manufacturer>Nokia</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vnd.wap.wml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="up">
<!--  United Planet WML stack -->    
        <user-agent-pattern>UP.*|.*UP\.Browser.*</user-agent-pattern>
        <manufacturer>United Planet</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vnd.wap.wml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="sonyericsson">
<!--  Sony - Ericsson WML stacks -->    
        <user-agent-pattern>Ercis.*|SonyE.*</user-agent-pattern>
        <manufacturer>SonyEricsson</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vnd.wap.wml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="wapalizer">
<!--  Wapalizer WML stacks -->    
        <user-agent-pattern>Wapalizer.*</user-agent-pattern>
        <manufacturer>Wapalizer</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vnd.wap.wml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="klondike">
<!--  Klondike WML stacks -->    
        <user-agent-pattern>Klondike.*</user-agent-pattern>
        <manufacturer>Klondike</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vnd.wap.wml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="wml_generic">
<!--  Generic WML stacks -->    
        <user-agent-pattern>.*WML.*|.*WAP.*|.*Wap.*|.*wml.*</user-agent-pattern>
        <manufacturer>Generic</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vnd.wap.wml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="vxml_generic">
<!--  Generic VoiceXML stacks -->    
        <user-agent-pattern>.*VoiceXML.*</user-agent-pattern>
        <manufacturer>Generic</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vxml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="nuance">
<!--  Nuance VoiceXML stack -->    
        <user-agent-pattern>Nuance.*</user-agent-pattern>
        <manufacturer>Nuance</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/vxml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>

    <client-entry name="agentxml">
<!--  Nuance VoiceXML stack -->    
        <user-agent-pattern>agentxml/1.0.*</user-agent-pattern>
        <manufacturer>Unknown</manufacturer>
        <model>Generic</model>
        <version></version>
        <mimetype-map>
            <mimetype>text/xml</mimetype>
        </mimetype-map>
        <capability-map/>
    </client-entry>
	<client-entry name="opera7" hidden="false">
        <user-agent-pattern>.*Opera/7.*</user-agent-pattern>
        <manufacturer>Opera</manufacturer>
        <model>Opera7</model>
        <version>7.x</version>
        <mimetype-map>
            <mimetype>text/html</mimetype>
            <mimetype>text/xhtml</mimetype>
            <mimetype>text/xml</mimetype>
        </mimetype-map>
        <capability-map>
            <capability>HTML_3_2</capability>
            <capability>HTML_4_0</capability>
            <capability>HTML_JAVA</capability>
            <capability>HTML_JAVA_JRE</capability>
            <capability>HTML_JAVASCRIPT</capability>
            <capability>HTML_TABLE</capability>
            <capability>HTML_NESTED_TABLE</capability>
            <capability>HTML_FORM</capability>
            <capability>HTML_FRAME</capability>
            <capability>HTML_IFRAME</capability>
            <capability>HTML_IMAGE</capability>
            <capability>HTML_CSS1</capability>
            <capability>HTML_CSS2</capability>
            <capability>HTML_CSSP</capability>
            <capability>HTML_DOM_1</capability>
            <capability>HTML_PLUGIN</capability>
            <capability>HTTP_COOKIE</capability>
        </capability-map>
    </client-entry>
</registry>
