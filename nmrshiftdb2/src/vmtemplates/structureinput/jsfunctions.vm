      #elseif($structureeditor=="GGAKETCHER")
        <script>
                function getKetcher()
                {
						var ketcherFrame = document.getElementById('ketcherFrame');
						var ketcher = null;
						if ('contentDocument' in ketcherFrame)
							ketcher = ketcherFrame.contentWindow.ketcher;
						else // IE7
							ketcher = document.frames['ketcherFrame'].window.ketcher;
						return ketcher;
                }

                function exportMol()
                {
                        var ketcher = getKetcher();
                        if (ketcher)
                                ketcher.getMolfile().then(meta => {document.MolForm.MolTxt.value=meta;document.MolForm.submit();});
                }
                

                function sleep(ms) {
                    return new Promise(resolve => setTimeout(resolve, ms));
                }

                function loadMol(){
                    #if($showoldinput=="true")
                        const ketcher = document.getElementById('ketcherFrame').contentWindow.ketcher;
                        // Chrome fires the onload event too early, so we have to wait until 'ketcher' exists.
                        if (ketcher) {
                           	    ketcher.setMolecule('$molfile');
                        } else {
                                setTimeout(() => onKetcherLoaded('ketcherFrame'), 0);
                        }
	           #end
                }

		        function openStructureHistory(){
		          mywindow=window.open("nmrshiftdbhtml/importfromstructureshistory.jsp;jsessionid=$session.getId()","molimport","height=200,width=900");
		          mywindow.focus();
		        }
        </script>
      #end
