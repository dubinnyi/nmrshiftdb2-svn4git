                    <tr>
                      <td bgcolor="#C0C0C0">DOI<br>Example: 10.1002/jlac.18611180314</td><td bgcolor="#C0C0C0"><input id="doi1" type="text" size="20" name="doijournal1" value="$journalarticle1.getDoi()"><input type="submit" name="eventSubmit_doResolvedoi" onclick="fillfromdoi(1)" value="Fill from DOI"></center></td>
                    </tr>
                <tr>
                  <td bgcolor="#C0C0C0">Author(s) separated with , or ; (names separated with blanks)*<br>Example: Gustav Kirchoff, Robert Bunsen</td><td bgcolor="#C0C0C0"><input type="text" size="100" name="authorjournal1" value="$journalarticle1.getAuthor()"></td>
                </tr>
                <tr>
                  <td bgcolor="#C0C0C0">Title of Publication<br>Example: Chemische Analyse durch Spectralbeobachtungen</td><td bgcolor="#C0C0C0"><input type="text" size="100" name="titlejournal1" value="$journalarticle1.getTitleForHtml()" onChange="literatureform.id1.checked=true"></td>
                </tr>
                <tr>
                  <td bgcolor="#C0C0C0">Subtitle of Publication (if any)</td><td bgcolor="#C0C0C0"><input type="text" size="100" name="subtitlejournal1" value="$journalarticle1.getSubtitleForHtml()"></td>
                </tr>
                        <tr>
                  <td bgcolor="#C0C0C0">Journal title, Subtitle (if any), abbreviation (if known)<br>Example: "Justus Liebigs Annalen der Chemie" as title, no subititle, "Liebigs Ann. Chem." as abbreviation</td>
                  <td bgcolor="#C0C0C0"><input type="text" size="25" name="journaltitlejournal1" value="$journalarticle1.getJournaltitle()">, <input type="text" size="25" name="journalsubtitlejournal1" value="$journalarticle1.getJournalsubtitle()">, <input type="text" size="5" name="itajournal1" value="$journalarticle1.getIta()"> </td>
                </tr>
                <tr>
                  <td bgcolor="#C0C0C0">Or choose journal from box:</td>
                  <td bgcolor="#C0C0C0" colspan="1">
                    <select name="choosejournal1" size="1" style="width:500px" onChange="document.restform.elements['journaltitlejournal1'].value='';document.restform.elements['journalsubtitlejournal1'].value='';">
                      #foreach($existingjournal in $existingjournals)
                        <option value="$existingjournal.getJournalId()">$existingjournal.getNiceTitle()</option>
                      #end
                    </select>
                  </td>
                <tr>
                <tr>
                  <td bgcolor="#C0C0C0">Year*, Volume, Issue<br>Example: 1861, 118</td>
                  <td bgcolor="#C0C0C0"><input type="text" size="4" maxlength="4" name="yearjournal1" value="$journalarticle1.getYear()">, <input type="text" size="4" maxlength="4" name="volumejournal1" value="$journalarticle1.getVolume()">, <input type="text" size="4" maxlength="4" name="issuejournal1" value="$journalarticle1.getIssue()"></td>
                </tr>
                <tr>
                  <td bgcolor="#C0C0C0">Pages</td>
                  <td bgcolor="#C0C0C0"><input type="text" size="6" maxlength="6" name="fromjournal1" value="$journalarticle1.getFrom()"> - <input type="text" size="6" maxlength="6" name="tojournal1" value="$journalarticle1.getTo()"></td>
                </tr>
                <tr>
                  <td bgcolor="#C0C0C0">Link (if no DOI exists)</td>
                  <td bgcolor="#C0C0C0"><input type="text" size="20" name="linkjournal1" value="$journalarticle1.getUrl()"></td>
                </tr>

