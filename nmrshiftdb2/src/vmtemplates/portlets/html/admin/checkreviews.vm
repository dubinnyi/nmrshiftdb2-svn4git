#if($error)
    $error
#else
    <span style="color:#0000AA">$!message</span><br>
    <h3>The following spectra are older than the selected period and have not yet been reviewed:</h3>
    <script LANGUAGE="JavaScript1.1">
    	function selectAll(){
    		var selects=document.checkreviewform.elements;
    		for(var i=0;i<selects.length;i++){
    			if(selects[i].type="checkbox"){
    				selects[i].checked=true;
    			}
    		}
    	}
    </script>
    <form action="portal;jsessionid=$data.getSession().getId()" method="post" name="setassignmentperiodform">
    	Show unreviewed spectra older than 
    	<select name="assignmentperiod">
    		<option value="0"
    		#if($show=="0")
    			selected 
    		#end
    		>Now</option>
    		<option value="1"
    		#if($show=="1")
    			selected 
    		#end
    		>1 week</option>
    		<option value="2" 
    		#if($show=="2")
    			selected 
    		#end
    		>2 weeks</option>
    		<option value="4" 
    		#if($show=="4")
    			selected 
    		#end
    		>1 month</option>
    		<option value="8" 
    		#if($show=="8")
    			selected 
    		#end
    		>2 month</option>
    		<option value="24" 
    		#if($show=="24")
    			selected 
    		#end
    		>6 month</option>
    	</select>
    	<input name="eventSubmit_doSetassignmentperiod" type="submit" value="Refresh">
    </form>
    <br>
    <form action="portal;jsessionid=$data.getSession().getId()" method="post" NAME="checkreviewform">
    	<table>
    		<tr>
    			<th>Id</th><th>Reviewer</th><th>Assigned since</th><th>Do action</th>
    		</tr>
    		#foreach($spectrum in $spectra)
    			<tr><td>$spectrum.getSpectrumId()</td><td>$spectrum.getNameOfAsssignedReviewer()</td><td>$spectrum.getAsssignedDate()</td><td><input type="checkbox" name="$spectrum.getSpectrumId()" value="$spectrum.getSpectrumId()"></td></tr>
    		#end
    	</table>
    	<br>
    	<input type="button" value="Check all" onClick="selectAll()">
    	<input type="reset" value="Clear all">
    	<select name="nmrshiftdbaction" size="1">
    		<option value="doreassignment">Assign to new reviewer</option>
    		<option value="sendreminder">Send reminder email</option>
    	</select>
    	<input name="eventSubmit_doAction" type="submit" value="Do">
    </form>
#end
