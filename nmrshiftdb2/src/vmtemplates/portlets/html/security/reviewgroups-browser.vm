*#

#set ( $headings = ["ReviewGroup Name", "Actions"] )

$!data.getParameters().get("message")

<table>

  <tr>
    <td>
      <table border="true" cellspacing="1" cellpadding="3">
        <tr>
          #foreach ($heading in $headings)
          #headerCell ($heading)
          #end
        </tr>

        #foreach ($reviewgroup in $reviewgroups)
        <tr>
          #entryCell ($reviewgroup.getReviewgroupName())
          <td>
              <form method="post" action="$jlink.setPanel("Review Groups").setAction("portlets.security.ReviewGroupsUpdateAction")">
                <input type="hidden" name="entityid" value="$!reviewgroup.getReviewgroupId()"/> 
                <input type="submit" name="eventSubmit_doDelete" value="Delete ReviewGroup"/>
              </form>
          </td>
        </tr>
        #end
      </table>
    </td>
  </tr>
  <tr>
    <form method="post" action="$jlink.setPanel("Review Groups").setAction("portlets.security.ReviewGroupsUpdateAction")">
    <input type="hidden" name="entityid" value="$!$reviewgroup.getReviewgroupId()"/> 
    <td>
      <tr>
        #if (!$rg)
            #set ($pname = "")
        #else
            #set ($pname = $rg.getReviewgroupName())
        #end
        #formCell ("ReviewGroup Name" "name" $pname)
      </tr>
      <tr>
        <td align="$ui.buttonAlignment" bgcolor="$!{skin.TitleBackgroundColor}">
            <input type="submit" name="eventSubmit_doInsert" value="Add ReviewGroup"/>
        </td>
    <td>
    </form>
  </tr>
</table>


