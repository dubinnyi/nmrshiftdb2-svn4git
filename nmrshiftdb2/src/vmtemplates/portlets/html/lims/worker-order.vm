#macro(time $name $dayofweek $machine $daynight)
	<select name="${name}_${dayofweek}_hour" size="1">
		#foreach ( $item in [0..23] )
			#if($daynight=="day")
      			<option #if($machine.getHourDay($dayofweek)==$item) selected #end>$item</option>
      		#else
      			<option #if($machine.getHourNight($dayofweek)==$item) selected #end>$item</option>
      		#end 
      	#end
    </select>
	<select name="${name}_${dayofweek}_minute" size="1">
		#if($daynight=="day")
	      <option #if($machine.getMinuteDay($dayofweek)==0) selected #end>0</option>
	      <option #if($machine.getMinuteDay($dayofweek)==10) selected #end>10</option>
	      <option #if($machine.getMinuteDay($dayofweek)==20) selected #end>20</option>
	      <option #if($machine.getMinuteDay($dayofweek)==30) selected #end>30</option>
	      <option #if($machine.getMinuteDay($dayofweek)==40) selected #end>40</option>
	      <option #if($machine.getMinuteDay($dayofweek)==50) selected #end>50</option>
	    #else
	      <option #if($machine.getMinuteNight($dayofweek)==0) selected #end>0</option>
	      <option #if($machine.getMinuteNight($dayofweek)==10) selected #end>10</option>
	      <option #if($machine.getMinuteNight($dayofweek)==20) selected #end>20</option>
	      <option #if($machine.getMinuteNight($dayofweek)==30) selected #end>30</option>
	      <option #if($machine.getMinuteNight($dayofweek)==40) selected #end>40</option>
	      <option #if($machine.getMinuteNight($dayofweek)==50) selected #end>50</option>
	    #end
    </select>
#end

<script LANGUAGE="JavaScript1.1">
    function emailFunction(emailorclipboard){
		var ctrl=document.getElementsByName('emailcheckbox');
		var i=0;
		var mailto='';
		if(emailorclipboard)
		    mailto='mailto:';
		while(c=ctrl[i++]){
		    if(c.id.startsWith('email:') && c.checked){
    		    singleemails=c.id.substring(6).split(',');
	       	    for(var email in singleemails){
    		       if(mailto.indexOf(singleemails[email].trim())==-1){
        	           mailto=mailto.concat(singleemails[email].trim()).concat(',');
        	       }
        	    }
        	}
    	}
    	if(emailorclipboard)
        	window.location.href = mailto;
        else
            window.prompt("Copy to clipboard: Ctrl+C, Enter", mailto);
    }
    function checkAll(checkOrUncheck){
    	var ctrl=document.getElementsByName('emailcheckbox');
    	for (var i =0; i < ctrl.length; i++) 
    	{
    	    if(ctrl[i].type == 'checkbox' && ctrl[i].id.startsWith('email:')) {
		      ctrl[i].checked = checkOrUncheck;
    		}
  		}
  	}
</script>

