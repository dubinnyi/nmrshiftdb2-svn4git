<form name="SearchHistoryForm" action="portal/js_pane/P-Results;jsessionid=$data.getSession().getId()" method="post">
<br>
<table cellpadding="2" cellspacing="0">
  <tr bgcolor="#0000AA">
    <th><div style="color:#FFFFFF">Repeat</div></th><th><div style="color:#FFFFFF">Type of search</div></th><th><div style="color:#FFFFFF">Mode</div></th><th><div style="color:#FFFFFF">Value</div></th><th><div style="color:#FFFFFF">Hits</div></th>
  </tr>
  #foreach($item in $searchhistory)
      #set($evenorodd=$velocityCount % 2)
      #if($evenorodd==1)
        <tr bgcolor="#D3D3D3">
      #else
        <tr bgcolor="#C0C0C0">
      #end
      <td><input type="checkbox" name="dosearch$velocityCount" value="dosearch"></td>
      <td>$item.getDisplayText()</td>
      <td>$item.getNameForElements()</td>
      <td>$item.getRangeWithoutZeros($data)</td>
      <td>$item.getLowerAsInt()</td>
    </tr>
  #end
</table>
<br><br>
<input type="checkbox" name="not" value="not">not</input> <input type="radio" name="andor" value="and" checked>and</input> <input type="radio" name="andor" value="or">or</input><br>
<input name="eventSubmit_doRepeatsearches" type="submit" style="background-color:#0000AA; color:white" value="Repeat marked search(es)"> <a href="portal/js_pane/P-Help;jsessionid=$data.getSession().getId()?URL=using.html#shistory" title="Help for search history" style="color:white"><img src="images/help.png"></a>
</form>
<form action="portal/js_pane/P-Search;jsessionid=$data.getSession().getId()" method="post" name="$nmrshiftdbconstansts.DELETE_SEARCH_HISTORY">
  <input name="eventSubmit_doClearhistory" type="submit" value="Clear search history">
</form>
