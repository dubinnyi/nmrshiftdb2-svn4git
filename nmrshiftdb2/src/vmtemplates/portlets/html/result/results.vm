#macro(showdetails $i)
<tr><td>
<table cellpadding="2" cellspacing="0">
  <tr>
    #if($browseBefore>-1)
      <td><a href="portal/js_pane/P-Results;jsessionid=$data.getSession().getId()?startMolecule=$startmolecule&nmrshiftdbaction=showDetails&molNumber=$browseBefore&spectrumType=$type&$start">Previous structure</a></td>
    #end
    #if($browseAfter>-1)
      <td><a href="portal/js_pane/P-Results;jsessionid=$data.getSession().getId()?startMolecule=$startmolecule&nmrshiftdbaction=showDetails&molNumber=$browseAfter&spectrumType=$type&$start">Next structure</a></td>
    #end
  </tr>
</table>
</td></tr>
#end

#if($showpredict=="true")
  <h3><a href="$link.getPaneById("P-Predict").addPathInfo("eventSubmit_doShowfromsession","showfromsession")">Return to prediction</a></h3>
#end
#if($showassignment=="true")
  <h3><a href="$link.getPaneById("P-Assign").addPathInfo("eventSubmit_doShowfromsession","showfromsession")">Return to assignment</a></h3>
#end
<h3>$header<a href="portal/js_pane/P-Help;jsessionid=$data.getSession().getId()?URL=using.html#browse" title="Help for results" style="color:white"><img src="images/help.png"></a></h3><br>
<span style="color:blue">$!messageduration</span><br>
<table cellpadding="2" cellspacing="0">
  <tr bgcolor="#0000AA">
    <th><div style="color:#FFFFFF">Type of search</div></th><th><div style="color:#FFFFFF">Mode</div></th><th><div style="color:#FFFFFF">Value</div></th><th><div style="color:#FFFFFF">Type</div></th>
  </tr>
  #foreach($item in $searches)
    #set($evenorodd=$velocityCount % 2)
    #if($evenorodd==1)
      <tr bgcolor="#D3D3D3">
    #else
      <tr bgcolor="#C0C0C0">
    #end
    <td>$item.getDisplayText()</td>
    <td>$item.getNameForElements()</td>
    <td>
      $item.getRangeWithoutZeros($data)
    </td>
    <td>
      $item.getMultiplicity()
    </td>
    </tr>
    #if($item.getDisplayText()=="my spectra")
      #set($myspectra="true")
    #end
  #end
</table>
<br><br>
#if($chiralMessage.getInt()==1)
  There was a chirality in one or more of your structure searches, but no matching molecule in the database. The chirality was ignored!<br><br>
#end
#if($chiralMessage.getInt()==2)
  There was a chirality in one or more of your structure searches and matching molecules in the database. Only these are displayed!<br><br>
#end
#if($chiralMessage.getString()!="")
  $chiralMessage.getString()<br><br>
#end
Results: $numberofresults<br><br>
Browse: $browsingline<br><br>
<hr>
