<script LANGUAGE="JavaScript1.1">
    function showlink(link){
        link = getAbsoluteUrl(link);
        window.prompt("Copy to clipboard: Ctrl+C, Enter", link);
        return false;
    }

    var getAbsoluteUrl = (function() {
        var a;

        return function(url) {
                if(!a) a = document.createElement('a');
                a.href = url;

                return a.href;
        };
    })();
</script>

