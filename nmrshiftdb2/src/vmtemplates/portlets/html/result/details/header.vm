#if($coords=="3d")
  <script LANGUAGE="JavaScript1.1" src="nmrshiftdbhtml/jsmol/JSmol.min.js"></script>
  <script>
	var Info = {
	  color: "#FFFFFF",
	  height: 300,
	  width: 300,
	  script: "load \"MOL::$urltool.getBaseUrl()/../$molfile\"",
	  use: "HTML5",
	  j2sPath: "j2s",
	  serverURL: "php/jsmol.php",
	};
		
		
    var currentlyworking=0;
    function select(atom,spectrumapplet,appletmview){
      if(currentlyworking==1){
        return;
      }else{
        currentlyworking=1;
        appletmview.selectAtom(atom);
        spectrumapplet.paintLine(atom);
        currentlyworking=0;
      }
    }
  </script>
#end
#if($mol.getCoordinateSetNames().size()>1)
  <form action="portal/js_pane/P-Results;jsessionid=${sessionidext}?startmolecule=$startmolecule&nmrshiftdbaction=$lastaction&molNumber=$molNumber" method="post">
    <select name="coordinateselect">
      #foreach($set in $mol.getCoordinateSetNames())
        <option value="$set.get(0)"
        #if($choosenset==$set.get(0))
          selected
        #end
        >$set.get(1)</option>
      #end
    </select>
    <input type="submit" value="Show with this coordinate set">
  </form>
#end
