function onofftocsy(){
    var noesys = document.querySelectorAll(".tocsy");
    for (i = 0; i < noesys.length; i++) {
        if(noesys[i].style.display === "none"){
            noesys[i].style.display = "block";
        }else{
            noesys[i].style.display = "none";
        }
    }
}

function onoffnoesy(){
    var noesys = document.querySelectorAll(".noesy");
    for (i = 0; i < noesys.length; i++) {
        if(noesys[i].style.display === "none"){
            noesys[i].style.display = "block";
        }else{
            noesys[i].style.display = "none";
        }
    }
}
