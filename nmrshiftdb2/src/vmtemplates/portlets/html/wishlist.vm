<p style="color:red">$!messages</p>
<p>Here users can leave structures for which they wish to have spectra in nmrshiftdb2.</p>
<p>Click on a structure to fullfill a wish!</p>
<table>
#foreach($row in $rows)
  <tr>
  #set($outercounter=$velocityCount)
  #foreach($field in $row)
    <td><a href="$field.get(0)"><img src="$field.get(1)"></a><br>$field.get(2)</td>
  #end
  </tr>
#end
</table>
<br><br>Add a new wish here:<br>
      #parse("structureinput/jsfunctions.vm")
      #parse("structureinput/display.vm")
  #if($data.getSession().getAttribute("applet")=="applet")
    
  #else
#if($structureeditor=="MARVINJS" || $data.getSession().getAttribute("applet")=="applet" || $import=="true")
  <form action="portal/js_pane/P-Wishlist=Guestbook;jsessionid=$data.getSession().getId()" method="post" NAME="MolForm">
    <input type="hidden" name="MolTxtWithH" value="">
    #if($data.getSession().getAttribute("applet")=="applet")
      <input type="button" value="Import from structures history" onClick="openStructureHistory()"><br>
    #end
    Wished spectrum type:
    <select size="1" name="spectrumType">
    #foreach($spectrumtype in $types)
       <option value="$spectrumtype.getSpectrumTypeId()">$spectrumtype.getName()</option>
    #end
    </select>
    <input TYPE="submit" name="eventSubmit_doEntry" style="background-color:#0000AA; color:white" VALUE="Write this to wishlist" onClick="exportMol()">
  </form>
#end

