    $!messageforenter
    You are not a reviewer or not logged in! If you are interested in becoming a reviewer, <a href="mailto:GeneralUtils.getAdminEmail(runData)">email</a> the administrator!
#elseif($message)
    <span style="color:#0000AA">$!message</span><br>
    <form action="$jslink.getPaneById("P-Review")" method="post">
