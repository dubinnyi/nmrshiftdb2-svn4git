                                <option value="g${type.getReviewtypeId()}">$type.getReviewtypeName()</option>
                            #end
                            #foreach($reviewer in $reviewers)
                                <option value="r$reviewer.getValue(1).asString()">$reviewer.getValue(2).asString() $reviewer.getValue(3).asString()</option>
                            #end
                        </select>
                        <input type="hidden" name="spectrumid" value="$spectrum.getSpectrumId()"><br>
                        <input type="submit" name="eventSubmit_doAssigngroup" value="Assign">
                    </form>
                </td>
