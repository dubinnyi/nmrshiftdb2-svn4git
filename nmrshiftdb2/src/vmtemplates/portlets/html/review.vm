    	      <tr>
                        <td>
                        	<object data="$baseurl/../download/NmrshiftdbServlet/${spectrum.getSpectrumId()}.pdf?spectrumid=${spectrum.getSpectrumId()}&nmrshiftdbaction=exportspec&format=pdforig" type="application/pdf" width="350" height="250">
    			  	<p>It appears you don't have a PDF plugin for this browser.
    				No problem... you can <a href="$baseurl/../download/NmrshiftdbServlet/${spectrum.getSpectrumId()}.pdf?spectrumid=${spectrum.getSpectrumId()}&nmrshiftdbaction=exportspec&format=pdforig">click here to
    				download the PDF file.</a></p>
    			</object>
                        </td>
                      </tr>
    	      #end
    	</tr>
    </table>
    <br>
    <div>Rating: $spectrum.getMark() $spectrum.getMarkComment()</div><br>
    #if($spectrum.getReportUrl())
    CSEARCH quality report:
    #if($spectrum.getReportUrlString().startsWith("<image"))
      <a target="_blank" href="download/NmrshiftdbServlet/$spectrum.getSpectrumId()report.htm;jsessionid=$data.getSession().getId()?nmrshiftdbaction=exportcsearchreport&spectrumid=$spectrum.getSpectrumId()">Download</a>
    #else
      <a target="_blank" href="$spectrum.getReportUrlString()">Download</a>
    #end
    <br>
    #end
    Chemical name(s): $mol.getChemicalNamesAsOneString(true, true)<br>
     #parse( "makeconfiguration.vm" )
    CAS Number: $mol.getCasNumber()<br>
    Canonical name: $mol.getCanonicalName()<br>
    Molecule keywords: $mol.getMoleculeKeywordsAsOneString()<br>
