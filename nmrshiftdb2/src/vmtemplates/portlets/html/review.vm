    				#parse("chooseedit.vm")
    				<input name="eventSubmit_doChecklogin" type="submit" value="Edit yourself and accept">
    			</form>
    		</td>
    		<td>
    			<form action="$jslink.getPaneById("P-Review")" method="post">
    				<input type="hidden" name="spectrumid" value="$spectrum.getSpectrumId()">
    				<input name="eventSubmit_doAccept" type="submit" value="Accept">
    			</form>
    		</td>
            #if($iseditor)
                <td>
                    <form action="$jslink.getPaneById("P-Review")" method="post">
                        Assign to group or reviewer:
