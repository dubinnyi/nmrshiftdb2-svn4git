    </form>
#else
    <table>
    	<tr>
    		<th colspan="3">Check the submitted data and choose either to accept or to discard them! <a href="$jslink.getPaneById("P-Help")?URL=using.html#review" title="Help for review" style="color:white"><img src="images/help.png"></a></th>
    	</tr>
    	<tr>
    		<th colspan="3">This is a $spectrum.getSpectrumTypeName() spectrum (ID: $spectrum.getSpectrumId()). #if($spectrum.getDBUserDBSpectrumEdits().size()>0) <span style="color:red">This spectrum has been edited and therefore needs to be reviewed again.</span> #end </th>
    	</tr>
    	<tr>
    		<td>
          #if($data.getSession().getAttribute("applet")=="applet")
            <a href="$data.getRequest().getRequestURI();jsessionid=$data.getSession().getId()?$data.getRequest().getQueryString()&applet=noapplet" title="Switch off Java applets" style="color:white"><img src="images/nojava.png"></a><span style="color:#0000AA">Double click to get resizeable window!</span><br>
            <script LANGUAGE="JavaScript1.1" SRC="nmrshiftdbhtml/marvin.js"></script>
            <script LANGUAGE="JavaScript1.1">
              <!--
              var currentlyworking=-1;
              function select(b){
                if(currentlyworking==1){
                  return;
                }else{
                  currentlyworking=1;
                  document.JcpViewer.selectAtom(b);
                  document.Spectrum.paintLine(b);
                  currentlyworking=0;
                }
              }
              msview_mayscript = true;
              mview_name = "JcpViewer";
              mview_begin("$baseurl/../nmrshiftdbhtml", 350, 250);
              mview_param("load","$baseurl/../$molfile");
              mview_param("atomNumbersVisible","true");
              mview_param("background","12632256");
              mview_param("detachable","true");
              mview_param("highlightTable","true");
              mview_end();
              //-->
            </script>
          #else
            #if($spectrum.getDBSpectrumType().getDimensionality()==1)<a href="#" onClick="window.open('$imagelink','pagename','resizable,height=500,width=700'); return false;">Show structure with shift values</a><a href="$data.getRequest().getRequestURI();jsessionid=$data.getSession().getId()?$data.getRequest().getQueryString()&applet=applet" title="Switch on Java-Applets" style="color:white"><img src="images/java.png"></a><br>#end
            <img src="$image"><br>
          #end
    		</td>
    		<td width=\"50\"></td>
    		<td>
          #if($data.getSession().getAttribute("applet")=="applet")
            <span style="color:#0000AA">Double click upper part to get resizeable window!</span><br>
            <script LANGUAGE="JavaScript1.1">
              spectrumapplet_name = "Spectrum";
              spectrumapplet_begin("$baseurl/../nmrshiftdbhtml", 350, 250);
              spectrumapplet_param("spectrumTyp","$spectrum.getDBSpectrumType().getNameAsString()");
              spectrumapplet_param("spectrum","$spectrum.getSpectrumForAppletNewFormat()");
              spectrumapplet_param("highlightTable","true");
              spectrumapplet_end();
            </script>
          #else
            #if($spectrum.getImage())
              <a href="download/NmrshiftdbServlet/${spectrum.getSpectrumId()}.$spectrum.getImageFormat()#if($spectrum.getReviewFlag()=="private");jsessionid=$data.getSession().getId()#end?spectrumid=${spectrum.getSpectrumId()}&nmrshiftdbaction=exportspec&format=originalimage" target="_blank">Show spectrum in full size</a><br>
            #end
            <img src="$specimage">
          #end
    		</td>
    		<td width=\"50\"></td>
    		<td>
    	    <table border="0" rules="none">
    	        #if($spectrum.getDBSpectrumType().getDimensionality()==1)
                    <tr bgcolor="#0000AA"><th><div style="color:white">Atom</div></th><th><div style="color:white">Signal</div></th><th><div style="color:white">Mult.<br>(coupling const.)</div></th>
        					<th width="15"></th><th><div style="color:white">Expected range for signal</div></th>
        					##<th><div style="color:white">CSEARCH Prediction</div></th>
                    </tr>
                #else
                    #foreach($axis in $spectrum.getDBSpectrumType().getDBIsotopes())
                        <th colspan="2"><div style="color:white">Axis: $velocityCount ($axis.getElementSymbol())</div></th>
                    #end
                    </tr><tr bgcolor="#0000AA">
                    #foreach($axis in $spectrum.getDBSpectrumType().getDBIsotopes())
                        #set( $column = ${velocityCount} * 2 - 2)
                        #if($velocityCount==1 || $spectrum.getDBSpectrumType().getSpectrumTypeId()!=14)
                            <th><div style="color:white">Atom</div></th>                                        
                        #end
                        #set( $column = ${velocityCount} * 2 - 1)
                        <th><div style="color:white">Shift</div></th>
                    #end
                #end
    		#foreach($option in $spectrum.getOptions(-1, false))
              #set($greyorwhite=$velocityCount%2)
              <tr id="tableid$option.getValue().intValue()"
              #if($greyorwhite==0)
                bgcolor="#D3D3D3" 
              #end
              onMouseover="select($option.getValue().intValue());style.backgroundColor='#FF6600';" onmouseout="style.backgroundColor='#if($greyorwhite==0) #D3D3D3 #else white #end';">
              #if($spectrum.getDBSpectrumType().getDimensionality()==1)
                  <td>
    	              #if($option.getIdentifier()=="")
    	                 $option.getDisplayText()
    	              #else
    	                 $option.getIdentifier()
    	              #end
                  </td>
                  <td>$option.getRange()</td>
                  <td>$option.getMultiplicity()</td>
                  <td></td>
                  <td><div 
						#if($option.getIsInRange())
							style="color:#0000FF"
						#else
							style="color:red"
						#end
						>$option.getNameForElements()</div>
                   </td>
              #else
                    #foreach($atom in $option.getSignal().getDBAtomsByAxis())
                        #foreach($axis in $atom)
                            #if($velocityCount==1 || $spectrum.getDBSpectrumType().getSpectrumTypeId()!=14)
                                <td align="center">
                                #if($axis.getSymbol()=="H")
                                    $axis.getMdlNumberPlus1HeavyOrIdentifier($spectrum.getSpectrumId())
                                #else
                                    $axis.getMdlNumberPlus1OrIdentifier($spectrum.getSpectrumId())
                                #end
                                </td>
                            #end
                            <td align="center">$option.getSignal().getDBShift($velocityCount).getValue()</td>
                        #end
                    #end
              #end 
              </tr>
			#end
  			</table>
    		</td>
    	      #if ($spectrum.getJcamp())
    	        <td>
    			<script language="JavaScript" type="text/javascript" src=
    			"nmrshiftdbhtml/JSVfunctions.js">
    			</script>
    	        <script language="javascript" type="text/javascript">
    			//<![CDATA[
    			  jsvls="load $baseurl/../download/NmrshiftdbServlet/${spectrum.getSpectrumId()}.dx;jsessionid=$data.getSession().getId()?nmrshiftdbaction=exportspec&spectrumid=$spectrum.getSpectrumId()&format=jcamp";
    			  insertJSVObject("$baseurl/../nmrshiftdbhtml/jspecview.jar","JSVApplet","350","250",jsvls);
    			//]]>
    			</script>
    	        </td>
    	      #end
