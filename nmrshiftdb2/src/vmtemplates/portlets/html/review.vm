    #foreach($link in $mol.getLinks())
    	<a target="_blank" href="$link.getHyperlink()">$link.getDescription()</a>; 
    #end
    Literature:
    #foreach($literature in $spectrum.getLiteraturesNew())
      $literature.toString()<br>
    #end
    Conditions:
    #foreach ($cond in $spectrum.getMeasurementConditions())
    	- $cond.getConditionName(): $cond.getValue() 
    #end
    <br>
    Additional comments: $spectrum.getCommentAsString()<br>
    Spectrum keywords: $spectrum.getKeywords()<br>
    Additional spectrum information available here: 
    #foreach($link in $spectrum.getLinks())
      <a target="_blank" href="$link.getHyperlink()">$link.getDescription()</a>; 
    #end<br>
    This spectrum was submitted by <a href="mailto:$spectrum.getContributor().getEmail()">$spectrum.getNmrshiftdbUser().getLoginName()</a> at $spectrum.getDate()
    #if($spectrum.getRawData())
    <br>
    <a href="download/NmrshiftdbServlet/${spectrum.getSpectrumId()}.$spectrum.getRawDataFormat()#if($spectrum.getReviewFlag()=="private");jsessionid=$data.getSession().getId()#end?spectrumid=${spectrum.getSpectrumId()}&nmrshiftdbaction=exportspec&format=rawdata" target="_blank">Download raw data</a>
    #end
    <br><br>
    <table>
    	<tr>
    		<td>
    			<form action="$jslink.getPaneById("P-Review")" method="post">
    				<input type="hidden" name="spectrumid" value="$spectrum.getSpectrumId()">
                    <input name="eventSubmit_doReject" type="submit" value="Reject and delete">
    			</form>
    		</td>
    		<td>
    			<form action="$jslink.getPaneById("P-Submit")" method="post">
    				<input type="hidden" name="nextaction" value="acceptandedit">
    				<input type="hidden" name="spectrumid" value="$spectrum.getSpectrumId()">
            		<input type="hidden" name="spectrum" value="$spectrum.getSpectrumId()">
