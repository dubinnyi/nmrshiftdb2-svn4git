	    <p><b>You did not enter the code from the image correctly. Sorry for this, but we need to prevent bots from submitting!"</b></p>
	#end
	<p><form action="$jlink.setAction("screens.GuestbookAction")" method="post">
	#if($urltool.showCaptcha() == true)
		<img src="img.captcha;jsessionid=$data.getSession().getId()"><br>
		Enter the code shown above here:<br>
		<input name="captcha" type="TEXT"> <br>
		New entry for guestbook (you need to enter the code to avoid spamming): <br/>
	#else
		New entry for guestbook: <br/>
	#end
<textarea cols="50" rows="5" name="text">
#if ($data.Message)
$data.Message
#else
Add new guestbook entry here!
#end
</textarea><br/>
	<input type="submit" value="Write entry" />
	</form></p>
#end
#foreach($entry in $entries)
  <p>
    <b>User $entry.getUserName() wrote at $entry.getDate():</b><br>
    $entry.getText()
  </p>
#end
</td></tr></table>
</center>
