<div>
<center>
<table cellpadding="2" cellspacing="0" border="1" width="50%">
      <tr>
        <td align="center" colspan="3" class="INPUTFORMTITLE">
          nmrshiftdb2 Guestbook
        </td>
      </tr>
<tr><td class="INPUTFORM">
<p>Logged-in Users are welcome to leave informal comments, suggestions etc. here. For reporting bugs, please use <a href="http://sourceforge.net/tracker/?group_id=348458&atid=1457043">the bug tracker</a>.</p>
#if ($data.User.hasLoggedIn())
	#if ($data.Message)
