<div align="left">
    <center>
    <table cellpadding="4" cellspacing="0" border="1" class=INPUTFORM>
    <tr>
      <td>
        <p>
        <h2>Password Reminder</h2>
        <p>Enter your email. You will be sent a new password and your username to this address.        </p>
#if ($data.Message)
        <b>$data.Message</b>
        <p />
#end
  <form accept-charset="UTF-8, ISO-8859-1" method="POST" action="$link.setPage("ConfirmRegistration")" enctype="application/x-www-form-urlencoded">
  <input name="$jlink.ActionKey" type="hidden" value="screens.RememberPassword" />

        <center>
        <table cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td> $l10n.USERFORM_EMAILMSG </td>
            <td align=right><input name="email" type="TEXT" value="$!urltool.escapeHtml($!data.Parameters.getString('email'))" /> </td>
            #if($data.Parameters.getString("enterusername"))
                </tr><tr><td> Username </td>
            	<td align=right><input name="username" type="TEXT" value="$!urltool.escapeHtml($!data.Parameters.getString('username'))" /> </td>
            #end
          </tr>
          <tr>
            <td colspan=2>&nbsp;</td>
          </tr> 
          <tr>
            <td align=right><input name="submit2" type="submit" value="Send reminder" class="BUTON"/></td>
          </tr>
        </table>
        </center>
      </td>
    </table>
    </center>
  </form>
</div>
 
