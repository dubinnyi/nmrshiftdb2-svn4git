	</variable>
	<variable name="TOTAL_Sum" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{C}]]></variableExpression>
	</variable>
	<variable name="GRP_MONTH_Sum" class="java.lang.Integer" resetType="Group" resetGroup="GRP_MONTH" calculation="Sum">
		<variableExpression><![CDATA[$F{C}]]></variableExpression>
	</variable>
