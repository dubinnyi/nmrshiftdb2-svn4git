	<field name="ROBOT" class="java.lang.Integer"/>
	<field name="MONTH" class="java.lang.Integer"/>
	<variable name="GRP_YEAR_Sum" class="java.lang.Integer" resetType="Group" resetGroup="GRP_YEAR" calculation="Sum">
