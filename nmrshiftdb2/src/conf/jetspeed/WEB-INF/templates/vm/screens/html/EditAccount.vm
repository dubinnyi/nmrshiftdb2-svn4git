                    #end
                    <td>&nbsp;</td>
                    #if($urltool.isLabserver())
                        <td>
                            </select><select name="aff2" size="1">
                              #foreach($day in $urltool.getAff2())
                                <option value="$day" #if($!urltool.getTurbineUser($data).getAffiliation2()==$day) selected #end >$day</option>
                              #end
