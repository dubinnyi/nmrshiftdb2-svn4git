                    #end
                    <td align=right><input name="affiliation2" type="TEXT" value="$!urltool.getTurbineUser($data).Affiliation2" /> </td>
                    #if($urltool.isLabserver())
                        <td>
                            </select><select name="aff2" size="1">
                              #foreach($day in $urltool.getAff2())
                                <option value="$day">$day</option>
                              #end
                            </select>
                        </td>
                    #end 
                #end
              </tr>
              <tr>
                <td> I want my real name to appear on the Credits page </td>
                <td>&nbsp;</td>
                <td align=right><input name="realname" type="checkbox" value="realname" 
