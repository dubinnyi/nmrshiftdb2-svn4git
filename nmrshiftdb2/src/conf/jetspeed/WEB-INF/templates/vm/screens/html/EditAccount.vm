                #end
                > </td>
              </tr>
                
                
                
                <tr>
                  <td colspan="3">$l10n.NEWACCOUNT_INFOEMAILMSG</td>
                </tr> 
                <tr>
                  <td colspan="3">&nbsp;</td>
                </tr> 
                <tr>
                  <td colspan="3">
                    <table width="100%">
                      <tr>
                        <td align="right" width="40%">
                          <input name="cancelBtn" type="submit" value="$l10n.USERFORM_CANCEL">
                        </td>
                        <td width="10%">&nbsp;</td>
                        <td align="left" width="40%">
                          <input name="submit2" type="submit" value="$l10n.USERFORM_UPDATE">
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </center>
          </form>
        </td>
      </tr>
    </table>
#end

