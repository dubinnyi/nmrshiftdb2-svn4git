#macro(displaymols $mollist $header $wheretolink)
      <table>
        <tr>
          <td colspan="10">
            $header
          </td>
        </tr>
        <tr>
        #foreach($mol in $mollist)
          #set($velocityCountM1=$velocityCount - 1)
          #set($test=$velocityCountM1%10)
            #if($test==0)
              #if($velocityCount==1)
                        
              #else
                </tr><tr>
              #end
            #end
          <td><a
          #if($wheretolink=="review")
              href="$jslink.getPaneById("P-Review").addQueryData("eventSubmit_doReview","doReview").addQueryData("spectrumid","$mol.getSpectrumId()").addQueryData("userid","$data.User.getUserId()")"
          #elseif($wheretolink=="showunreviewed")
              href="$jslink.getPaneById("P-Results").addQueryData("nmrshiftdbaction","showDetailsFromHome").addQueryData("newmol","true").addQueryData("molNumber","$mol.getDBMolecule().getMoleculeId()").addQueryData("unreviewed","unreviewed")"
          #else
              href="$jslink.getPaneById("P-Results").addQueryData("nmrshiftdbaction","showDetailsFromHome").addQueryData("newmol","true").addQueryData("molNumber","$mol.getDBMolecule().getMoleculeId()")"
          #end
          >
          <img alt="$mol.getDBMolecule().getChemicalNamesAsOneStringWithFallback()" 
          #if($urltool.doImageCache())
              src="images/molecules/small/${mol.getMoleculeId()}.jpeg"
          #else
              src="download/NmrshiftdbServlet/${mol.getMoleculeId()}.jpg;jsessionid=$data.getSession().getId()?nmrshiftdbaction=exportmol&spectrumid=$mol.getSpectrumId()&format=jpeg&size=150x150&shownumbers=false&backcolor=12632256"
          #end      
          >
          </a><br>
          ID: $mol.getSpectrumId() - $mol.getDBSpectrumType().getName()
          </td>
        #end
        </tr>
      </table>
#end

<table cellpadding="0" cellspacing="0" border="0" width="100%"  >
  <tr>
    <td valign="top">
      <table align="left" cellspacing="0" border="0" cellpadding="0"  >
        <tr width="100%">
            #foreach($tabheader in $tabheaders)
              #set($currenttab=$velocityCount - 1)
              #if($selectedtab==$currenttab)
                  <td valign="middle"  class="HighlightTitleStyleClass"   style="background-color: #0000AA; color: #FFFFFF;"  >
                          $tabheader
                  </td>
              #else
                   <td valign="middle"  class="TitleStyleClass"   style="background-color: #999999; color: #FFFFFF;"  >
                          <a href="$link.setPage("EditAccount")?tab=$currenttab"  style="color: #FFFFFF" >$tabheader</a>
                  </td>
              #end
              <td width="5">&nbsp;</td>
            #end
        </tr>
      </table>
      <table align="right" cellspacing="0" border="0" cellpadding="0">
        <tr width="100%">    
          <td align="right" nowrap="true" valign="middle"></td>
        </tr>      
      </table>
    </td>
  </tr>
</table>
<table cellspacing="0" width="100%" border="0" cellpadding="0"  >
  <tr><td height="2"  style="background-color: #0000AA"  ><img height="2" width="2" src="images/dot.gif" /></td></tr>
  <tr><td height="2"  style="background-color: #FFFFFF"  ><img height="2" width="2" src="images/dot.gif" /></td></tr>
</table>
<center><table>
#if($urltool.getTurbineUser($data).getUnsavedSpectraCount($data)>0)
