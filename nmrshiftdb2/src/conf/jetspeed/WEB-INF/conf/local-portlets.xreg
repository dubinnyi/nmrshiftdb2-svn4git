        <parameter name="action"
            value="portlets.admin.CheckReviewsAction" hidden="true"
            cachedOnName="true" cachedOnValue="true"/>
        <media-type ref="html"/>
        <url cachedOnURL="true"/>
	<security role="admin"/>
    </portlet-entry>
    <portlet-entry name="ReviewGroupsBrowser" hidden="false" type="ref"
