<?xml version="1.0" encoding="UTF-8"?>
<registry>
    <portlet-entry name="Details" hidden="false" type="ref"
        parent="Velocity" application="false">
        <meta-info>
            <title>Details</title>
            <description>The details of a molecule</description>
        </meta-info>
        <classname>org.apache.jetspeed.portal.portlets.VelocityPortlet</classname>
        <parameter name="template" value="result/details/details"
            hidden="true" cachedOnName="true" cachedOnValue="true"/>
        <parameter name="action"
            value="portlets.result.DetailsAction" hidden="true"
            cachedOnName="true" cachedOnValue="true"/>
        <media-type ref="html"/>
        <url cachedOnURL="true"/>
    </portlet-entry>
    <portlet-entry name="Bookmarks" hidden="false" type="ref"
        parent="Velocity" application="false">
        <meta-info>
            <title>Bookmarks</title>
            <description>Shows bookmarks for structures</description>
        </meta-info>
        <classname>org.apache.jetspeed.portal.portlets.VelocityPortlet</classname>
        <parameter name="template" value="result/bookmarks"
            hidden="true" cachedOnName="true" cachedOnValue="true"/>
        <parameter name="action"
            value="portlets.result.BookmarkAction" hidden="true"
            cachedOnName="true" cachedOnValue="true"/>
        <media-type ref="html"/>
        <url cachedOnURL="true"/>
    </portlet-entry>
    <portlet-entry name="Results" hidden="false" type="ref"
